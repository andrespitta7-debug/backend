# ==============================================================================
# SysQuest - Plantilla de Variables de Entorno para Docker Compose (.env.example)
# INSTRUCCIONES:
# Copiar este archivo a '.env' y asignar valores reales y seguros.
# NUNCA commitear el archivo '.env' real en repositorios públicos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL)
# Generar una clave de alta entropía (mínimo 16 caracteres alfanuméricos)
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD=CambiarPorPasswordSeguroDeAltaEntropia123!
DB_PORT=54322

# ------------------------------------------------------------------------------
# 2. Seguridad y Criptografía (JWT Secrets)
# Generar con: openssl rand -base64 36
# Debe tener al menos 32 caracteres y ser idéntica para GoTrue y PostgREST
# ------------------------------------------------------------------------------
JWT_SECRET=super-secure-jwt-secret-with-minimum-32-characters-entropy-needed-here
JWT_EXPIRY=3600

# ------------------------------------------------------------------------------
# 3. Supabase Auth y APIs
# ------------------------------------------------------------------------------
# URL pública del Gateway (Kong) consumida por el frontend
PUBLIC_API_URL=http://localhost:54321
# Clave anónima pública generada a partir de JWT_SECRET con rol 'anon'
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# URL de callback y dominio externo para correos transaccionales de Auth
API_EXTERNAL_URL=http://localhost:54321/auth/v1
SITE_URL=http://localhost:8080

# Control de registro público (true para bloquear altas en producción, false para abierto)
GOTRUE_DISABLE_SIGNUP=false

# ------------------------------------------------------------------------------
# 4. Puertos de Exposición en Host
# ------------------------------------------------------------------------------
FRONTEND_PORT=8080
KONG_PORT=54321
