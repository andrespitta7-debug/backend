# SysQuest — Variables de entorno (ejemplo)
# Copia este archivo a .env y reemplaza con los valores reales.
# NUNCA commitees el .env real.

# URL del proyecto Supabase (Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publica (anon / publishable key). Segura para el cliente.
SUPABASE_ANON_KEY=tu_anon_key_aqui

# Clave privada (service_role / secret key). SOLO en el backend.
# NUNCA la expongas en el cliente Flutter ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
